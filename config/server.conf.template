[server]
ip=0.0.0.0
port=8080
thread_num=4
idle_timeout=30

[mysql]
host=127.0.0.1
port=3306
database=pan_ult
user=${MYSQL_USER}
password=${MYSQL_PASSWORD}
pool_size=10

[redis]
host=127.0.0.1
port=6379
pool_size=5

[storage]
base_path=data/objects/
temp_path=data/temp/

[feishu]
app_id=${FEISHU_APP_ID}
app_secret=${FEISHU_APP_SECRET}
redirect_uri=https://your-domain.com/api/auth/feishu/callback

[jwt]
secret=${JWT_SECRET}
expire_seconds=3600